{
  "name": "Desktop Actions Example",
  "description": "Example script showing basic desktop automation actions",
  "created": 1680813600,
  "modified": 1680813600,
  "steps": [
    {
      "type": "desktop",
      "action": "click",
      "x": 100,
      "y": 100,
      "description": "Click at position (100, 100)",
      "delay": 1.0
    },
    {
      "type": "desktop",
      "action": "key_press",
      "key": "ctrl+a",
      "description": "Select all text (Ctrl+A)",
      "delay": 0.5
    },
    {
      "type": "desktop",
      "action": "type",
      "text": "Hello, Automation Tool!",
      "description": "Type sample text",
      "delay": 0.5
    },
    {
      "type": "wait",
      "duration": 2,
      "description": "Wait for 2 seconds",
      "delay": 0.0
    },
    {
      "type": "desktop",
      "action": "key_press",
      "key": "enter",
      "description": "Press Enter key",
      "delay": 0.5
    }
  ]
}
