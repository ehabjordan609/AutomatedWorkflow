{
  "name": "Website Login Example",
  "description": "Example script showing website login automation",
  "created": 1680813600,
  "modified": 1680813600,
  "steps": [
    {
      "type": "web",
      "action": "start_browser",
      "browser": "chrome",
      "headless": false,
      "description": "Start Chrome browser",
      "delay": 1.0
    },
    {
      "type": "web",
      "action": "navigate",
      "url": "https://example.com/login",
      "description": "Navigate to the login page",
      "delay": 2.0
    },
    {
      "type": "web",
      "action": "type",
      "selector": {
        "type": "id",
        "value": "username"
      },
      "text": "your_username",
      "description": "Enter username",
      "delay": 0.5
    },
    {
      "type": "web",
      "action": "type",
      "selector": {
        "type": "id",
        "value": "password"
      },
      "text": "your_password",
      "description": "Enter password",
      "delay": 0.5
    },
    {
      "type": "web",
      "action": "click",
      "selector": {
        "type": "css",
        "value": "button[type='submit']"
      },
      "description": "Click login button",
      "delay": 1.0
    },
    {
      "type": "wait",
      "duration": 5,
      "description": "Wait for login to complete",
      "delay": 0.0
    }
  ]
}
